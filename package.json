{
  "name": "solidjscad",
  "displayName": "solidJScad",
  "description": "Using JavaScript and @ jscad/modeling for 3D/2D graphic modeling,Using the ECMAScript Modules standard,Using Threejs to display,Vscode plugin that can be previewed in webview or browser.",
  "version": "0.0.17",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:solidjscad.json"
  ],
  "contributors": [
    {
      "name": "Weijie Zhao",
      "email": "zaddone@qq.com"
    }
  ],
  "main": "./dist/extension.js",
  "icon": "./myModule/logo.png",
  "repository": "https://github.com/sureboy/solidJSCADExt",
  "publisher": "WeijieZhao",
  "contributes": {
    "configuration": {
      "title": "solidjscad",
      "properties": {
        "solidjscad.in": {
          "type": "string",
          "default": "index.js",
          "description": "入口文件 (Entry file)"
        },
        "solidjscad.src": {
          "type": "string",
          "default": "src",
          "description": "源代码文件夹 (Source folder)"
        },
        "solidjscad.func": {
          "type": "string",
          "default": "main",
          "description": "入口函数名 (Entry function name)"
        },
        "solidjscad.webui": {
          "type": "string",
          "default": "webui",
          "description": "WebUI 文件夹路径 (WebUI folder path)"
        },
        "solidjscad.config": {
          "type": "string",
          "default": "solidjscad.json",
          "description": "配置文件名称 (Configuration file name)"
        },
        "solidjscad.serverUrl": {
          "type": "array",
          "default": ["solidjscad.com","solidjscad.cn"],
          "description": "服务器地址列表 (Server URL list)"
        },
        "solidjscad.port": {
          "type": "number",
          "default": 3000,
          "description": "HTTP 服务器端口号 (HTTP server port number)"
        },
        "solidjscad.webview": {
          "type": "boolean",
          "default": true,
          "description": "是否启用 Webview (Enable Webview)"
        },
        "solidjscad.watchFolder":{
          "type": "boolean",
          "default": true,
          "description": "检测到专用配置文件时自动启动预览 (Automatically start preview when a dedicated configuration file is detected)"          
        },
        "solidjscad.includeImport": {
          "type": "object",
          "default": {
            "@jscad/modeling": "./lib/modeling.esm.js",
            "csgChange": "./lib/csgChange.js", 
            "manifold-3d":"./lib/manifold/manifold.js"
          },
          "description": "模块导入映射，键为包名，值为本地路径 (Import mapping: package name to local path)"
        }
      }
    },
    "commands": [
      {
        "command": "solidJScad.create",
        "title": "solidjscad create"
      },
      {
        "command": "solidJScad.onload",
        "title": "solidjscad onload"
      },
      {
        "command": "solidJScad.stop",
        "title": "solidjscad stop"
      }
    ],
    "customEditors": [
      {
        "viewType": "solidJScad.stlPreview",
        "displayName": "STL Preview",
        "selector": [
          {
            "filenamePattern": "*.stl"
          }
        ]
      },
      {
        "viewType": "solidJScad.3mfPreview",
        "displayName": "3MF Preview",
        "selector": [
          {
            "filenamePattern": "*.3mf"
          }
        ]
      },
      {
        "viewType": "solidJScad.gzPreview",
        "displayName": "gz Preview",
        "selector": [
          {
            "filenamePattern": "*.solidjscad.gz"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "npx npx esbuild ./src/nodeHttpServer.ts --outfile=./myModule/HttpServer.js --minify --bundle --format=esm --platform=node  --external:vscode --external:ws"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.89.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "bufferutil": "^4.0.9",
    "esbuild": "^0.27.0",
    "eslint": "^9.25.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "utf-8-validate": "^6.0.5",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1"
  }
}
